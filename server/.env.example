# =========================================================================
# unigig server — environment variables
# Copy this file to `.env.development` for local dev and `.env` for prod.
# =========================================================================

# --- Core ---
NODE_ENV=development
PORT=4000

# --- Database (Docker Postgres locally; managed Postgres in prod) ---
DATABASE_URL=postgresql://unigig:unigig@localhost:5432/unigig?schema=public

# --- JWT ---
# Generate strong secrets for prod: `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`
JWT_ACCESS_SECRET=dev-access-secret-change-me-in-prod
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-in-prod
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- CORS ---
# Comma-separated list of allowed origins. In prod, set to your deployed client URL.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Email verification gate ---
# Users must verify email before login succeeds. In dev, verification emails
# are written to server/dev-emails/ and logged to the console.
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_FROM=noreply@unigig.local
APP_URL=http://localhost:3000

# --- Email provider (dev=console, prod=resend/sendgrid) ---
EMAIL_PROVIDER=console

# Uncomment + set when switching to Resend (or set in prod env):
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=

# --- Google OAuth (DISABLED by default; flip to true to enable) ---
# Build & test the rest of the app first; turn this on when you trust the deploy.
# To enable:
#   1. Create OAuth client at https://console.cloud.google.com/apis/credentials
#   2. Set GOOGLE_AUTH_ENABLED=true and fill the values below
#   3. Add a "Sign in with Google" button on the client and POST the credential
#      to /api/auth/google
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- File storage ---
# local: writes to server/uploads/   |   s3: production S3/R2 (not implemented yet)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_PUBLIC_URL=http://localhost:4000/uploads

# Uncomment for S3/R2 in prod:
# STORAGE_DRIVER=s3
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
